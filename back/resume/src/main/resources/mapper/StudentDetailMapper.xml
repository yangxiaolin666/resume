<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.resume.company.mapper.StudentDetailMapper">
    
    <resultMap id="StudentDetailMap" type="com.resume.model.dto.StudentDetailDTO">
        <id property="id" column="id"/>
        <result property="stuId" column="stu_id"/>
        <result property="name" column="name"/>
        <result property="age" column="age"/>
        <result property="gender" column="gender"/>
        <result property="nation" column="nation"/>
        <result property="major" column="major"/>
        <result property="degree" column="degree"/>
        <result property="graduationYear" column="graduation_year"/>
        <result property="internship" column="internship"/>
        
        <!-- 关联映射 -->
        <association property="region" javaType="com.resume.model.dto.RegionDTO">
            <result property="province" column="province"/>
            <result property="city" column="city"/>
        </association>
        
        <association property="resume" javaType="com.resume.model.dto.ResumeDTO">
            <result property="resume" column="resume_url"/>
        </association>
        
        <!-- 集合映射 -->
        <collection property="languages" ofType="com.resume.model.dto.LanguageDTO">
            <result property="language" column="language"/>
            <result property="level" column="language_level"/>
            <result property="certNo" column="language_cert_no"/>
            <result property="issueDate" column="language_issue_date"/>
        </collection>
        
        <collection property="certificates" ofType="com.resume.model.dto.CertificateDTO">
            <result property="certName" column="cert_name"/>
            <result property="level" column="certificate_level"/>
            <result property="certNo" column="certificate_cert_no"/>
            <result property="issueDate" column="certificate_issue_date"/>
        </collection>
        
        <collection property="internships" ofType="com.resume.model.dto.InternshipDTO">
            <result property="company" column="company"/>
            <result property="experience" column="experience"/>
        </collection>
        
        <collection property="jobs" ofType="com.resume.model.dto.JobDTO">
            <result property="post" column="post"/>
        </collection>
        
        <collection property="specialities" ofType="com.resume.model.dto.SpecialityDTO">
            <result property="speciality" column="speciality"/>
        </collection>
    </resultMap>
    
    <select id="selectStudentDetailsByCondition" resultMap="StudentDetailMap">
        SELECT 
        s.id,
        s.stu_id,
        s.name,
        s.age,
        s.gender,
        s.nation,
        s.major,
        s.degree,
        s.graduation_year,
        s.internship,
        sr.province AS province,
        sr.city AS city,
        slr.language AS language,
        slr.level AS language_level,
        slr.cert_no AS language_cert_no,
        slr.issue_date AS language_issue_date,
        sc.cert_name AS cert_name,
        sc.level AS certificate_level,
        sc.cert_no AS certificate_cert_no,
        sc.issue_date AS certificate_issue_date,
        si.company AS company,
        si.experience AS experience,
        sj.post AS post,
        ss.speciality AS speciality,
        srsm.resume AS resume_url
        FROM student s
        LEFT JOIN stu_region sr ON s.id = sr.stu_id
        LEFT JOIN stu_language slr ON s.id = slr.stu_id
        LEFT JOIN stu_certificate sc ON s.id = sc.stu_id
        LEFT JOIN stu_internship si ON s.id = si.stu_id
        LEFT JOIN stu_job sj ON s.id = sj.stu_id
        LEFT JOIN stu_speciality ss ON s.id = ss.stu_id
        LEFT JOIN stu_resume srsm ON s.id = srsm.stu_id
        <where>
            <if test="query.id != null">
                AND s.id = #{query.id}
            </if>
            <if test="query.stuId != null">
                AND s.stu_id = #{query.stuId}
            </if>
            <if test="query.name != null and query.name != ''">
                AND s.name LIKE CONCAT('%', #{query.name}, '%')
            </if>
            <if test="query.age != null">
                AND s.age = #{query.age}
            </if>
            <if test="query.gender != null and query.gender != ''">
                AND s.gender = #{query.gender}
            </if>
            <if test="query.nation != null and query.nation != ''">
                AND s.nation LIKE CONCAT('%', #{query.nation}, '%')
            </if>
            <if test="query.major != null and query.major != ''">
                AND s.major LIKE CONCAT('%', #{query.major}, '%')
            </if>
            <if test="query.degree != null and query.degree != ''">
                AND s.degree = #{query.degree}
            </if>
            <if test="query.graduationYear != null">
                AND s.graduation_year >= #{query.graduationYear}
            </if>
            <if test="query.internship != null">
                AND s.internship >= #{query.internship}
            </if>
            <if test="query.cities != null and query.cities.size() > 0">
                AND sr.city IN
                <foreach collection="query.cities" item="city" open="(" separator="," close=")">
                    #{city}
                </foreach>
            </if>
            <if test="query.provinces != null and query.provinces.size() > 0">
                AND sr.province IN
                <foreach collection="query.provinces" item="province" open="(" separator="," close=")">
                    #{province}
                </foreach>
            </if>
            <if test="query.languages != null and query.languages.size() > 0">
                AND slr.language IN
                <foreach collection="query.languages" item="language" open="(" separator="," close=")">
                    #{language}
                </foreach>
            </if>
            <if test="query.languageLevel != null and query.languageLevel != ''">
                AND slr.level LIKE CONCAT('%', #{query.languageLevel}, '%')
            </if>
            <if test="query.certNames != null and query.certNames.size() > 0">
                AND sc.cert_name IN
                <foreach collection="query.certNames" item="certName" open="(" separator="," close=")">
                    #{certName}
                </foreach>
            </if>
            <if test="query.certLevel != null and query.certLevel != ''">
                AND sc.level LIKE CONCAT('%', #{query.certLevel}, '%')
            </if>
            <if test="query.internshipCompany != null and query.internshipCompany != ''">
                AND si.company LIKE CONCAT('%', #{query.internshipCompany}, '%')
            </if>
            <if test="query.specialities != null and query.specialities.size() > 0">
                AND ss.speciality IN
                <foreach collection="query.specialities" item="speciality" open="(" separator="," close=")">
                    #{speciality}
                </foreach>
            </if>
        </where>
        ORDER BY s.id
    </select>
</mapper>