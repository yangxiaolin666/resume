<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.resume.company.mapper.StudentDetailMapper">
    
    <resultMap id="StudentDetailMap" type="com.resume.model.dto.StudentDetailDTO">
        <id property="id" column="id"/>
        <result property="stuId" column="stu_id"/>
        <result property="name" column="name"/>
        <result property="age" column="age"/>
        <result property="gender" column="gender"/>
        <result property="nation" column="nation"/>
        <result property="major" column="major"/>
        <result property="degree" column="degree"/>
        <result property="graduationYear" column="graduation_year"/>
        <result property="internship" column="internship"/>
        
        <!-- 关联映射 -->
        <association property="region" javaType="com.resume.model.dto.RegionDTO">
            <result property="province" column="province"/>
            <result property="city" column="city"/>
        </association>
        
        <association property="resume" javaType="com.resume.model.dto.ResumeDTO">
            <result property="resume" column="resume_url"/>
        </association>
    </resultMap>
    
    <!-- 用于查询学生基本信息的映射 -->
    <resultMap id="StudentBasicInfoMap" type="com.resume.model.dto.StudentDetailDTO">
        <id property="id" column="id"/>
        <result property="stuId" column="stu_id"/>
        <result property="name" column="name"/>
        <result property="age" column="age"/>
        <result property="gender" column="gender"/>
        <result property="nation" column="nation"/>
        <result property="major" column="major"/>
        <result property="degree" column="degree"/>
        <result property="graduationYear" column="graduation_year"/>
        <result property="internship" column="internship"/>
        
        <!-- 关联映射 -->
        <association property="region" javaType="com.resume.model.dto.RegionDTO">
            <result property="province" column="province"/>
            <result property="city" column="city"/>
        </association>
        
        <association property="resume" javaType="com.resume.model.dto.ResumeDTO">
            <result property="resume" column="resume_url"/>
        </association>
    </resultMap>
    
    <!-- 语言信息映射 -->
    <resultMap id="LanguageDTOMap" type="com.resume.model.dto.LanguageDTO">
        <result property="stuId" column="stu_id"/>
        <result property="language" column="language"/>
        <result property="level" column="language_level"/>
        <result property="certNo" column="language_cert_no"/>
        <result property="issueDate" column="language_issue_date"/>
    </resultMap>
    
    <!-- 证书信息映射 -->
    <resultMap id="CertificateDTOMap" type="com.resume.model.dto.CertificateDTO">
        <result property="stuId" column="stu_id"/>
        <result property="certName" column="cert_name"/>
        <result property="level" column="certificate_level"/>
        <result property="certNo" column="certificate_cert_no"/>
        <result property="issueDate" column="certificate_issue_date"/>
    </resultMap>
    
    <!-- 实习信息映射 -->
    <resultMap id="InternshipDTOMap" type="com.resume.model.dto.InternshipDTO">
        <result property="stuId" column="stu_id"/>
        <result property="company" column="company"/>
        <result property="experience" column="experience"/>
    </resultMap>
    
    <!-- 求职信息映射 -->
    <resultMap id="JobDTOMap" type="com.resume.model.dto.JobDTO">
        <result property="stuId" column="stu_id"/>
        <result property="post" column="post"/>
    </resultMap>
    
    <!-- 专业技能信息映射 -->
    <resultMap id="SpecialityDTOMap" type="com.resume.model.dto.SpecialityDTO">
        <result property="stuId" column="stu_id"/>
        <result property="speciality" column="speciality"/>
    </resultMap>
    
    <select id="selectStudentDetailsByCondition" resultMap="StudentBasicInfoMap">
        SELECT 
        s.id,
        s.stu_id,
        s.name,
        s.age,
        s.gender,
        s.nation,
        s.major,
        s.degree,
        s.graduation_year,
        s.internship,
        sr.province AS province,
        sr.city AS city,
        srsm.resume AS resume_url
        FROM student s
        LEFT JOIN stu_region sr ON s.id = sr.stu_id
        LEFT JOIN (
            SELECT stu_id, resume, 
                   ROW_NUMBER() OVER (PARTITION BY stu_id ORDER BY id DESC) as rn
            FROM stu_resume
        ) srsm ON s.id = srsm.stu_id AND srsm.rn = 1
        <where>
            <if test="query.id != null">
                AND s.id = #{query.id}
            </if>
            <if test="query.stuId != null">
                AND s.stu_id = #{query.stuId}
            </if>
            <if test="query.name != null and query.name != ''">
                AND s.name LIKE CONCAT('%', #{query.name}, '%')
            </if>
            <if test="query.age != null">
                AND s.age = #{query.age}
            </if>
            <if test="query.gender != null and query.gender != ''">
                AND s.gender = #{query.gender}
            </if>
            <if test="query.nation != null and query.nation != ''">
                AND s.nation LIKE CONCAT('%', #{query.nation}, '%')
            </if>
            <if test="query.major != null and query.major != ''">
                AND s.major LIKE CONCAT('%', #{query.major}, '%')
            </if>
            <if test="query.degree != null and query.degree != ''">
                AND s.degree = #{query.degree}
            </if>
            <if test="query.graduationYear != null">
                AND s.graduation_year = #{query.graduationYear}
            </if>
            <if test="query.internship != null">
                AND s.internship >= #{query.internship}
            </if>
            <if test="query.cities != null and query.cities.size() > 0">
                AND sr.city IN
                <foreach collection="query.cities" item="city" open="(" separator="," close=")">
                    #{city}
                </foreach>
            </if>
            <if test="query.provinces != null and query.provinces.size() > 0">
                AND sr.province IN
                <foreach collection="query.provinces" item="province" open="(" separator="," close=")">
                    #{province}
                </foreach>
            </if>
            <if test="query.languageQueries != null and query.languageQueries.size() > 0">
                AND (
                    <foreach collection="query.languageQueries" item="langQuery" separator="OR">
                        EXISTS (
                            SELECT 1 FROM stu_language 
                            WHERE stu_id = s.id 
                            AND language = #{langQuery.language}
                            <if test="langQuery.level != null and langQuery.level != ''">
                                AND level = #{langQuery.level}
                            </if>
                        )
                    </foreach>
                )
            </if>
            <if test="query.certNames != null and query.certNames.size() > 0">
                AND EXISTS (
                    SELECT 1 FROM stu_certificate 
                    WHERE stu_id = s.id 
                    AND cert_name IN 
                    <foreach collection="query.certNames" item="certName" open="(" separator="," close=")">
                        #{certName}
                    </foreach>
                )
            </if>
            <if test="query.certLevel != null and query.certLevel != ''">
                AND s.id IN (
                    SELECT stu_id FROM stu_certificate 
                    WHERE level LIKE CONCAT('%', #{query.certLevel}, '%')
                )
            </if>
            <if test="query.internshipCompany != null and query.internshipCompany != ''">
                AND s.id IN (
                    SELECT stu_id FROM stu_internship 
                    WHERE company LIKE CONCAT('%', #{query.internshipCompany}, '%')
                )
            </if>
            <if test="query.specialities != null and query.specialities.size() > 0">
                AND EXISTS (
                    SELECT 1 FROM stu_speciality 
                    WHERE stu_id = s.id 
                    AND speciality IN 
                    <foreach collection="query.specialities" item="speciality" open="(" separator="," close=")">
                        #{speciality}
                    </foreach>
                )
            </if>
            <if test="query.jobs != null and query.jobs.size() > 0">
                AND EXISTS (
                    SELECT 1 FROM stu_job 
                    WHERE stu_id = s.id 
                    AND post IN 
                    <foreach collection="query.jobs" item="job" open="(" separator="," close=")">
                        #{job}
                    </foreach>
                )
            </if>
        </where>
        ORDER BY s.id
    </select>
    
    <!-- 专门用于获取语言信息的查询 -->
    <select id="selectLanguagesByStudentIds" resultMap="LanguageDTOMap">
        SELECT 
            slr.stu_id,
            slr.language,
            slr.level as language_level,
            slr.cert_no as language_cert_no,
            slr.issue_date as language_issue_date
        FROM stu_language slr
        WHERE slr.stu_id IN
        <foreach collection="studentIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        ORDER BY slr.stu_id, slr.id
    </select>
    
    <!-- 专门用于获取证书信息的查询 -->
    <select id="selectCertificatesByStudentIds" resultMap="CertificateDTOMap">
        SELECT 
            sc.stu_id,
            sc.cert_name as cert_name,
            sc.level as certificate_level,
            sc.cert_no as certificate_cert_no,
            sc.issue_date as certificate_issue_date
        FROM stu_certificate sc
        WHERE sc.stu_id IN
        <foreach collection="studentIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        ORDER BY sc.stu_id, sc.id
    </select>
    
    <!-- 专门用于获取实习信息的查询 -->
    <select id="selectInternshipsByStudentIds" resultMap="InternshipDTOMap">
        SELECT 
            si.stu_id,
            si.company,
            si.experience
        FROM stu_internship si
        WHERE si.stu_id IN
        <foreach collection="studentIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        ORDER BY si.stu_id, si.id
    </select>
    
    <!-- 专门用于获取求职信息的查询 -->
    <select id="selectJobsByStudentIds" resultMap="JobDTOMap">
        SELECT 
            sj.stu_id,
            sj.post
        FROM stu_job sj
        WHERE sj.stu_id IN
        <foreach collection="studentIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        ORDER BY sj.stu_id, sj.id
    </select>
    
    <!-- 专门用于获取专业技能信息的查询 -->
    <select id="selectSpecialitiesByStudentIds" resultMap="SpecialityDTOMap">
        SELECT 
            ss.stu_id,
            ss.speciality
        FROM stu_speciality ss
        WHERE ss.stu_id IN
        <foreach collection="studentIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        ORDER BY ss.stu_id, ss.id
    </select>
</mapper>