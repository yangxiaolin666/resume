<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.resume.admin.mapper.SkillsMapper">


    <insert id="addSkills">
        INSERT INTO admin_all_skills (skillName,create_time)
        values
        <foreach collection="skills" item="skill"  separator=",">
            (#{skill}, #{date})
        </foreach>
    </insert>


    <delete id="deleteSkill">
        DELETE FROM admin_all_skills
        WHERE skillName IN
        <foreach collection="skill" item="item" open="(" separator="," close=")">
            #{item}
        </foreach>
    </delete>


    <select id="getAllSkill" resultType="java.lang.String">
        SELECT GROUP_CONCAT(skillName SEPARATOR ',') FROM admin_all_skills
    </select>
</mapper>