<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.resume.admin.mapper.CompanyMapper">

    <!-- 结果映射 -->
    <resultMap id="CompanyResultMap" type="com.resume.model.entity.Company">
        <id column="id" property="id"/>
        <result column="com_name" property="comName"/>
        <result column="com_region" property="comRegion"/>
        <result column="user_id" property="userId"/>
    </resultMap>

    <!-- 根据ID查询企业 -->
    <select id="selectCompanyById" resultMap="CompanyResultMap">
        SELECT id, com_name, com_region, user_id
        FROM company
        WHERE id = #{id}
    </select>

    <!-- 根据用户ID查询企业 -->
    <select id="selectCompanyByUserId" resultMap="CompanyResultMap">
        SELECT id, com_name, com_region, user_id
        FROM company
        WHERE user_id = #{userId}
    </select>

</mapper>
